# Токен бота из @BotFather. СЕКРЕТ — не коммитить! На Render задаётся в дашборде.
BOT_TOKEN=123456789:ABCdef...

# Postgres (напр. Supabase, как у FitPulse). Пусто = in-memory (только для локалки, данные не сохраняются).
DATABASE_URL=postgresql://user:pass@host:5432/postgres?sslmode=no-verify

# Случайная строка — попадает в URL вебхука как секрет (чтобы чужие не слали апдейты).
WEBHOOK_SECRET=смени-на-случайную-строку

# Публичный адрес ЭТОГО сервера (для setup-webhook).
PUBLIC_URL=https://colorlines-bot.onrender.com

# Разрешённые origin мини-аппа (через запятую) — для CORS.
WEBAPP_ORIGINS=https://1stgul9.github.io

# Адрес самой игры (для кнопки в /start).
WEBAPP_URL=https://1stgul9.github.io/colorlines/

PORT=3000
